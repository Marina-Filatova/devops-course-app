@Library('my-shared-lib@main') _

node(params.ENVIRONMENT) {
    timestamps {
        try{
            stage('Pull Image') {
                echo "Pulling image mfilatova/currency-rest-api:${params.IMAGE_TAG} on ${params.ENVIRONMENT}"
                sh "docker pull mfilatova/currency-rest-api:${params.IMAGE_TAG}"
            }
            
            stage('Deploy Container') {
                echo "Stopping old container..."
                sh 'docker-compose down || true'
                        
                echo "Starting new container with tag ${params.IMAGE_TAG}..."
                sh "IMAGE_TAG=${params.IMAGE_TAG} docker-compose up -d"
                        
                echo "Waiting for container to start..."
                sh 'sleep 5'
                sh 'docker-compose ps'
            }
            
            stage('Smoke Test') {
                runSmokeTest('http://localhost:8000/info')
                runSmokeTest('http://localhost:8000/info/currency?currency=USD&date=2023-01-17')
            }
        }
        finally{
            stage('Post Actions'){
                echo "=== Container logs ==="
                sh 'docker-compose logs || true'

                if (currentBuild.result == 'FAILURE') {
                    echo "Deployment failed! Cleaning up..."
                    sh 'docker-compose down || true'
                }
            }
        }
    }
}