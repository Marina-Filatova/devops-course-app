@Library('my-shared-lib@main') _

pipeline {
    agent { label "${params.ENVIRONMENT}" }
    
    options {
        timestamps()
    }
    
    stages {
        stage('Pull Image') {
            steps {
                script {
                    echo "Pulling image m_filatova/app:${params.IMAGE_TAG} on ${params.ENVIRONMENT}"
                    sh "docker pull mfilatova/currency-rest-api:${params.IMAGE_TAG}"
                }
            }
        }
        
        stage('Deploy Container') {
            steps {
                script {
                    echo "Stopping old container..."
                    sh 'docker stop app-main || true'
                    sh 'docker rm app-main || true'
                    
                    echo "Starting new container..."
                    sh "docker run -d --name app-main -p 8000:8000 mfilatova/currency-rest-api:${params.IMAGE_TAG}"
                    
                    echo "Waiting for container to start..."
                    sh 'sleep 5'
                    sh 'docker ps | grep app-main'
                }
            }
        }
        
        stage('Smoke Test') {
            steps {
                script {
                    // Вызов функции из Shared Library
                    runSmokeTest('http://localhost:8000/info')
                    runSmokeTest('http://localhost:8000/info/currency?currency=USD&date=2023-01-17')
                }
            }
        }
    }
    
    post {
        always {
            echo "=== Container logs ==="
            sh 'docker logs app-main || true'
        }
        failure {
            echo "Deployment failed! Cleaning up..."
            sh 'docker stop app-main || true'
            sh 'docker rm app-main || true'
        }
    }
}